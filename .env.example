# ============================================================
# Telegram Bot Configuration
# Copy this file to .env and fill in real values
# ============================================================

# Bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Admin chat ID (send /start to @userinfobot to get your ID)
ADMIN_CHAT_ID=your_admin_chat_id_here

# Google Sheets spreadsheet ID (from the URL: .../spreadsheets/d/<ID>/edit)
SPREADSHEET_ID=your_google_sheet_id_here

# Google Service Account credentials file
CREDENTIALS_FILE=credentials.json

# Backup file for undelivered orders
BACKUP_FILE=orders_backup.json

# Cloudflare Worker URL used as a proxy for Telegram API
# Example: https://your-worker.your-account.workers.dev
TELEGRAM_API_PROXY_URL=https://your-worker.your-account.workers.dev
